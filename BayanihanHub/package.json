{
  "name": "temp-setup",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "python backend/run.py",
    "backend:venv": "backend\\.venv\\Scripts\\python.exe backend\\run.py",
    "dev:all": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run backend:venv\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
