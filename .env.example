# ============================================================
# BayanihanHub Frontend — Environment Configuration Template
# ============================================================

# Environment ('beta' | 'production' | 'development')
VITE_APP_ENV=beta

# Application Name
VITE_APP_NAME=BayanihanHub

# Google Maps Platform Client Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_api_key_here

# Production Site URL (Used for SEO, Canonical URLs, and Sitemaps)
# Example: https://bayanihanhub.com
VITE_SITE_URL=

# Note: VITE_API_URL is NOT required because vercel.json handles API routing via rewrites.

# ============================================================
# BayanihanHub Backend — Environment Configuration Template
# ============================================================
# Environment
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=10000

# CORS (Frontend URL, e.g., https://bayanihanhub.vercel.app)
CORS_ORIGINS=https://bayanihanhub.vercel.app,https://bayanihanhub.com

# Database (Aiven MySQL)
MYSQL_HOST=your-aiven-host.aivencloud.com
MYSQL_PORT=19213
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=bayanihan_hub
# Required for Aiven SSL
# DATABASE_URL=mysql+pymysql://avnadmin:password@host:port/bayanihan_hub?ssl_ca=/path/to/ca.pem

# Secrets
JWT_SECRET=generate_a_secure_random_string_here
