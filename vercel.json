{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://bayanihanhub-api.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://bayanihanhub-api.onrender.com/uploads/$1"
    },
    {
      "source": "/((?!api/|uploads/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
