{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://dsl-unlike-stood-heading.trycloudflare.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://dsl-unlike-stood-heading.trycloudflare.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "bayanihanhub-api"
      }
    }
  ],
  "services": {
    "bayanihanhub-api": {
      "root": ".",
      "framework": "vite"
    }
  }
}
