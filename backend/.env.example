# ============================================================
# BayanihanHub Backend — Production Environment Template
# ============================================================

# Server Configuration
PORT=3001
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false

# Security & Session
JWT_SECRET=your_production_jwt_secret_key_here

# Allowed CORS Origins (comma-separated, e.g. https://bayanihanhub.com,http://localhost:5173)
CORS_ORIGINS=https://bayanihanhub.com,http://localhost:5173

# Frontend Base URL
FRONTEND_URL=https://bayanihanhub.com

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=bayanihan_user
MYSQL_PASSWORD=your_secure_db_password
MYSQL_DATABASE=bayanihan_hub
DATABASE_URL=mysql+pymysql://bayanihan_user:your_secure_db_password@localhost:3306/bayanihan_hub?charset=utf8mb4

# Identity Verification Service (optional external provider)
VERIFICATION_PROVIDER=biometric
VERIFICATION_API_KEY=your_verification_api_key_here

# Email Notification Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_team_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=noreply@bayanihanhub.com
SMTP_FROM_NAME=BayanihanHub
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Telegram Community Notification Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
